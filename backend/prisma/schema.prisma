// ─── RAISE DIAGNOSTICS ──────────────────────────────────────────────────────

model DiagnosticsReport {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  reportDate            DateTime @default(now()) @map("report_date") @db.Date
  dropoutByStage        Json     @default("{}") @map("dropout_by_stage") @db.JsonB
  topDropoutTopics      Json     @default("[]") @map("top_dropout_topics") @db.JsonB
  highPerformingPhrases Json     @default("[]") @map("high_performing_phrases") @db.JsonB
  lowPerformingPhrases  Json     @default("[]") @map("low_performing_phrases") @db.JsonB
  velocityTrend         String   @default("stable") @map("velocity_trend") @db.VarChar(20) // accelerating, stable, decelerating
  narrativeSummary      String?  @map("narrative_summary") @db.Text


// ─── SHARED WORKSPACE ───────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members OrgMember[]
  notes   ContactNote[]
  feed    ActivityFeed[]
  decks   PitchDeck[]

  @@map("organizations")
}

model OrgMember {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  role      String   @default("contributor") @db.VarChar(20) // owner, contributor, viewer
  invitedBy String?  @map("invited_by") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId], name: "uq_org_member")
  @@map("org_members")
}

model ContactNote {
  id        String @id @default(uuid()) @db.Uuid
  contactId String @map("contact_id") @db.Uuid
  orgId     String @map("org_id") @db.Uuid
  authorId  String @map("author_id") @db.Uuid

  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt(sort: Desc)])
  @@map("contact_notes")
}

model ActivityFeed {
  id        String  @id @default(uuid()) @db.Uuid
  orgId     String  @map("org_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  contactId String? @map("contact_id") @db.Uuid

  activityType String   @map("activity_type") @db.VarChar(50) // email_sent, stage_changed, note_added, brief_viewed
  metadata     Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, contactId])
  @@map("activity_feed")
}

// ─── PITCH DECK HOSTING ─────────────────────────────────────────────────────

model PitchDeck {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  orgId  String? @map("org_id") @db.Uuid

  filename   String  @db.VarChar(255)
  storageUrl String  @map("storage_url") @db.Text
  pageCount  Int     @default(0) @map("page_count")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization? @relation(fields: [orgId], references: [id])
  shares DeckShare[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("pitch_decks")
}

model DeckShare {
  id        String  @id @default(uuid()) @db.Uuid
  deckId    String  @map("deck_id") @db.Uuid
  contactId String? @map("contact_id") @db.Uuid

  shareToken String    @unique @default(uuid()) @map("share_token") @db.VarChar(255)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  deck  PitchDeck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  views DeckView[]

  @@index([deckId])
  @@map("deck_shares")
}

model DeckView {
  id      String @id @default(uuid()) @db.Uuid
  shareId String @map("share_id") @db.Uuid

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  pagesViewed Int[]     @map("pages_viewed")
  timePerPage Json      @default("{}") @map("time_per_page") @db.JsonB // {pageNum: secondsSpent}
  viewerIp    String?   @map("viewer_ip") @db.VarChar(50)

  share DeckShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, startedAt(sort: Desc)])
  @@map("deck_views")
}

// ─── FEATURE INTELLIGENCE ENGINE ─────────────────────────────────────────────

model FounderProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  appName            String  @map("app_name") @db.VarChar(255)
  appDescription     String  @map("app_description") @db.Text
  targetMarket       String  @map("target_market") @db.VarChar(255)
  currentMRR         Int     @default(0) @map("current_mrr") // USD
  stage              String  @db.VarChar(20) // pre-seed | seed | series-a | series-b
  fundingGoal        Int     @default(0) @map("funding_goal") // USD
  crunchbaseProfileUrl String? @map("crunchbase_profile_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureAnalyses FeatureAnalysis[]

  @@map("founder_profiles")
}

model FeatureAnalysis {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  founderId  String @map("founder_id") @db.Uuid

  featureName        String  @map("feature_name") @db.VarChar(255)
  featureDescription String  @map("feature_description") @db.Text
  estimatedBuildDays Int?    @map("estimated_build_days")
  featureCategory    String  @map("feature_category") @db.VarChar(50) // retention|acquisition|revenue|moat|dx

  status             String  @default("pending") @db.VarChar(20) // pending|running|complete|failed
  errorMessage       String? @map("error_message") @db.Text

  verdict            String? @db.VarChar(30) // build|defer|kill|needs-validation
  verdictReasoning   String? @map("verdict_reasoning") @db.Text
  revenueImpactLow   Int     @default(0) @map("revenue_impact_low")
  revenueImpactHigh  Int     @default(0) @map("revenue_impact_high")
  investorAlignmentScore Int @default(0) @map("investor_alignment_score") // 0-100

  marketPrecedents   Json    @default("[]") @map("market_precedents") @db.JsonB
  alignedInvestors   Json    @default("[]") @map("aligned_investors") @db.JsonB
  recommendations    Json    @default("[]") @db.JsonB

  rawMarketResearch  String? @map("raw_market_research") @db.Text
  modelVersion       String  @default("claude-sonnet-4-20250514") @map("model_version") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  founderProfile FounderProfile @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("feature_analyses")
}
